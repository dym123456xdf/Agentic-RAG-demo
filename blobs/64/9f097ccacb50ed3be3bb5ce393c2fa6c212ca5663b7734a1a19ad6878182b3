Tools\\miniconda3\\Scripts\\conda.exe"}]}, {"type": "image", "index": 8, "bbox": [0.125, 0.322, 0.875, 0.708], "content": [{"type": "image_body", "index": 8, "bbox": [0.125, 0.322, 0.875, 0.708], "content": ""}]}, {"type": "text", "index": 9, "bbox": [0.173, 0.726, 0.324, 0.743], "content": [{"type": "text", "content": "import langchain"}]}, {"type": "text", "index": 10, "bbox": [0.172, 0.758, 0.429, 0.776], "content": [{"type": "text", "content": "print(langchain.__version__)"}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.122, 0.825, 0.433, 0.85], "content": [{"type": "text", "content": "5、大模型应用场景介绍"}], "level": 2}, {"type": "text", "index": 12, "bbox": [0.122, 0.862, 0.431, 0.879], "content": [{"type": "text", "content": "大模型应用技术特点:门槛低，天花板高。"}]}]}, {"page_idx": 17, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.122, 0.036, 0.272, 0.057], "content": [{"type": "text", "content": "5.1 RAG开发"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.123, 0.071, 0.189, 0.088], "content": [{"type": "text", "content": "1）背景"}], "level": 2}, {"type": "text", "index": 2, "bbox": [0.122, 0.097, 0.868, 0.133], "content": [{"type": "text", "content": "大模型的知识冻结", "styles": ["underline"]}, {"type": "text", "content": " :随着 LLM 规模扩大，训练成本与周期相应增加，模型 "}, {"type": "text", "content": "无法实时学习", "styles": ["underline"]}, {"type": "text", "content": " 到最新的信息或动态变化。导致 LLM 难以应对诸如“请推荐现在的热门影片”等时间敏感的问题。"}]}, {"type": "text", "index": 3, "bbox": [0.122, 0.143, 0.864, 0.178], "content": [{"type": "text", "content": "大模型幻觉", "styles": ["underline"]}, {"type": "text", "content": " :涉及到大模型从未在训练过程中学习过的信息时，大模型无法给出准确的答复，转而开始臆想和编造答案。"}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.123, 0.188, 0.189, 0.204], "content": [{"type": "text", "content": "2）举例"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.121, 0.215, 0.867, 0.251], "content": [{"type": "text", "content": "LLM在考试的时候面对陌生的领域，答复能力有限，然后就准备放飞自我了，而此时RAG给了一些提示和思路，让LLM懂了开始往这个提示的方向做，最终考试的正确率从60%到了90%！"}]}, {"type": "image", "index": 6, "bbox": [0.13, 0.263, 0.626, 0.351], "content": [{"type": "image_body", "index": 6, "bbox": [0.13, 0.263, 0.626, 0.351], "content": ""}]}, {"type": "image", "index": 7, "bbox": [0.134, 0.401, 0.863, 0.49], "content": [{"type": "image_body", "index": 7, "bbox": [0.134, 0.401, 0.863, 0.49], "content": ""}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.123, 0.503, 0.232, 0.52], "content": [{"type": "text", "content": "3）何为RAG？"}], "level": 2}, {"type": "text", "index": 9, "bbox": [0.123, 0.53, 0.502, 0.547], "content": [{"type": "text", "content": "Retrieval-Augmented Generation（检索增强生成）"}]}, {"type": "text", "index": 10, "bbox": [0.123, 0.558, 0.162, 0.573], "content": [{"type": "text", "content": "图1:"}]}, {"type": "image", "index": 11, "bbox": [0.149, 0.599, 0.855, 0.917], "content": [{"type": "image_body", "index": 11, "bbox": [0.149, 0.599, 0.855, 0.917], "content": ""}, {"type": "image_footnote", "index": 12, "bbox": [0.494, 0.897, 0.832, 0.914], "content": [{"type": "text", "content": "LangChain + ChatGLM Made by imClumsyPanda"}]}]}, {"type": "page_number", "index": 13, "bbox": [0.125, 0.944, 0.16, 0.959], "content": [{"type": "text", "content": "图2:"}]}]}, {"page_idx": 18, "blocks": [{"type": "image", "index": 0, "bbox": [0.142, 0.044, 0.86, 0.223], "content": [{"type": "image_body", "index": 0, "bbox": [0.142, 0.044, 0.86, 0.223], "content": ""}]}, {"type": "text", "index": 1, "bbox": [0.145, 0.245, 0.858, 0.279], "content": [{"type": "text", "content": "检索-增强-生成过程:检索可以理解为第10步，增强理解为第13步（这里的提示词包含检索到的数据），生成理解为第15步。"}]}, {"type": "image", "index": 2, "bbox": [0.125, 0.288, 0.874, 0.57], "content": [{"type": "image_body", "index": 2, "bbox": [0.125, 0.288, 0.874, 0.57], "content": ""}]}, {"type": "text", "index": 3, "bbox": [0.145, 0.581, 0.71, 0.598], "content": [{"type": "text", "content": "这些过程中的难点:1、文件解析 2、文件切割 3、知识检索 4、知识重排序"}]}, {"type": "text", "index": 4, "bbox": [0.146, 0.608, 0.768, 0.625], "content": [{"type": "text", "content": "1、文件解析:如果是pdf，内部包含文件、图片、表格，图片上还有文字，需要处理。"}]}, {"type": "text", "index": 5, "bbox": [0.146, 0.635, 0.377, 0.652], "content": [{"type": "text", "content": "2、文件切割:没有固定的格式"}]}, {"type": "text", "index": 6, "bbox": [0.145, 0.663, 0.842, 0.716], "content": [{"type": "text", "content": "3、在 RAG 应用中，随着文档数量增加，召回准确率会下降，引入reranker（重排器）可对初步召回的较多 chunk（如 top 20 或 top 50）进行精排，提高召回准确率，防止LLM 处理无关信息，减少时间和成本。"}]}, {"type": "text", "index": 7, "bbox": [0.145, 0.725, 0.846, 0.76], "content": [{"type": "text", "content": "此外，与基于基本矢量搜索的 RAG 相比，reranker增强型 RAG 的成本更高，但与仅依靠LLM 生成答案相比，它的成本低些。"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.123, 0.77, 0.294, 0.786], "content": [{"type": "text", "content": "Reranker的使用场景:"}], "level": 2}, {"type": "text", "index": 9, "bbox": [0.139, 0.797, 0.874, 0.831], "content": [{"type": "text", "content": "适合:追求 "}, {"type": "text", "content": "回答高精度", "styles": ["underline"]}, {"type": "text", "content": " 和 "}, {"type": "text", "content": "高相关性", "styles": ["underline"]}, {"type": "text", "content": " 的场景中特别适合使用 Reranker，例如专业知识库或者客服系统等应用。"}]}, {"type": "text", "index": 10, "bbox": [0.14, 0.833, 0.821, 0.867], "content": [{"type": "text", "content": "不适合:引入reranker会增加召回时间，增加检索延迟。服务对 "}, {"type": "text", "content": "响应时间要求高", "styles": ["underline"]}, {"type": "text", "content": " 时，使用reranker可能不合适。"}]}]}, {"page_idx": 19, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.123, 0.036, 0.293, 0.058], "content": [{"type": "text", "content": "5.2 Agent开发"}], "level": 2}, {"type": "text", "index": 1, "bbox": [0.122, 0.071, 0.875, 0.106], "content": [{"type": "text", "content": "充分利用 LLM 的推理决策能力，通过增加规划、记忆和工具调用的能力，构造一个能够独立思考、逐步完成给定目标的 Agent（智能体）。"}]}, {"type": "text", "index": 2, "bbox": [0.123, 0.115, 0.201, 0.131], "content": [{"type": "text", "content": "类比举例:"}]}, {"type": "image", "index": 3, "bbox": [0.125, 0.141, 0.874, 0.241], "content": [{"type": "image_body", "index": 3, "bbox": [0.125, 0.141, 0.874, 0.241], "content": ""}]}, {"type": "text", "index": 4, "bbox": [0.123, 0.251, 0.872, 0.284], "content": [{"type": "hyperlink", "url": "https://lilianweng.github.io/posts/2023-06-23-agent/", "content": [{"type": "text", "content": "OpenAI的元老翁丽莲(Lilian Weng)于2023年6月在个人博客（https://lilianweng.github.io/posts/2023-06-23-agent/）首次提出了现代AI Agent架构。"}]}]}, {"type": "image", "index": 5, "bbox": [0.125, 0.292, 0.874, 0.527], "content": [{"type": "image_body", "index": 5, "bbox": [0.125, 0.292, 0.874, 0.527], "content": ""}]}, {"type": "text", "index": 6, "bbox": [0.123, 0.537, 0.284, 0.553], "content": [{"type": "text", "content": "一个数学公式来表示:"}]}, {"type": "text", "index": 7, "bbox": [0.123, 0.566, 0.541, 0.581], "content": [{"type": "text", "content": "Agent = LLM + Planning + Tools + Memory + Action", "styles": ["bold"]}]}, {"type": "text", "index": 8, "bbox": [0.146, 0.592, 0.307, 0.608], "content": [{"type": "text", "content": "比如，打车到西藏玩。"}]}, {"type": "text", "index": 9, "bbox": [0.146, 0.618, 0.335, 0.634], "content": [{"type": "text", "content": "大脑中枢:规划行程的你"}]}, {"type": "text", "index": 10, "bbox": [0.145, 0.646, 0.589, 0.663], "content": [{"type": "text", "content": "规划:步骤1:规划打车路线，步骤2:订饭店、酒店，。。。"}]}, {"type": "text", "index": 11, "bbox": [0.146, 0.673, 0.741, 0.689], "content": [{"type": "text", "content": "调用工具:调用MCP或FunctionCalling等API，滴滴打车、携程、美团订酒店饭店"}]}, {"type": "text", "index": 12, "bbox": [0.145, 0.699, 0.858, 0.735], "content": [{"type": "text", "content": "记忆能力:沟通时，要知道上下文。比如订酒店得知道是西藏路上的酒店，不能聊着聊着忘了最初的目的。"}]}, {"type": "text", "index": 13, "bbox": [0.146, 0.744, 0.488, 0.761], "content": [{"type": "text", "content": "能够执行上述操作。说走就走，不能纸上谈兵。"}]}, {"type": "text", "index": 14, "bbox": [0.123, 0.772, 0.382, 0.788], "content": [{"type": "text", "content": "智能体核心要素被细化为以下模块:"}]}, {"type": "text", "index": 15, "bbox": [0.122, 0.799, 0.782, 0.816], "content": [{"type": "text", "content": "1、大模型（LLM）作为“大脑”", "styles": ["bold"]}, {"type": "text", "content": ":提供推理、规划和知识理解能力，是AI Agent的决策中枢。"}]}, {"type": "text", "index": 16, "bbox": [0.145, 0.826, 0.853, 0.861], "content": [{"type": "text", "content": "大脑主要由一个大型语言模型 LLM 组成，承担着信息处理和决策等功能， 并可以呈现推理和规划的过程，能很好地应对未知任务。"}]}, {"type": "text", "index": 17, "bbox": [0.122, 0.898, 0.851, 0.933], "content": [{"type": "text", "content": "2、规划决策（Planning）", "styles": ["bold"]}, {"type": "text", "content": ":通过任务分解、反思与自省框架实现复杂任务处理。例如，利用思维链（Chain of Thought）将目标拆解为子任务，并通过反馈优化策略。"}]}]}, {"page_idx": 20, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.393, 0.045, 0.606, 0.073], "content": [{"type": "text", "content": "秘塔AI搜索"}], "level": 2}, {"type": "text", "index": 1, "bbox": [0.409, 0.082, 0.59, 0.1], "content": [{"type": "text", "content": "没有广告，直达结果"}]}, {"type": "text", "index": 2, "bbox": [0.177, 0.137, 0.365, 0.155], "content": [{"type": "text", "content": "对比QWQ和DeepSeek-r1|"}]}, {"type": "text", "index": 3, "bbox": [0.192, 0.199, 0.229, 0.213], "content": [{"type": "text", "content": "全网"}]}, {"type": "text", "index": 4, "bbox": [0.261, 0.199, 0.331, 0.213], "content": [{"type": "text", "content": "长思考·R1"}]}, {"type": "text", "index": 5, "bbox": [0.353, 0.251, 0.387, 0.266], "content": [{"type": "text", "content": "简洁"}]}, {"type": "image", "index": 6, "bbox": [0.743, 0.194, 0.82, 0.218], "content": [{"type": "image_body", "index": 6, "bbox": [0.743, 0.194, 0.82, 0.218], "content": ""}]}, {"type": "text", "index": 7, "bbox": [0.482, 0.251, 0.517, 0.266], "content": [{"type": "text", "content": "深入"}]}, {"type": "text", "index": 8, "bbox": [0.591, 0.249, 0.66, 0.268], "content": [{"type": "text", "content": "研究"}]}, {"type": "paragraph_title", "index": 9, "bbox": [0.146, 0.304, 0.436, 0.327], "content": [{"type": "text", "content": "对比QWQ和DeepSeek-r1"}], "level": 2}, {"type": "text", "index": 10, "bbox": [0.147, 0.341, 0.229, 0.356], "content": [{"type": "text", "content": "三研究中..."}]}, {"type": "text", "index": 11, "bbox": [0.162, 0.395, 0.293, 0.41], "content": [{"type": "text", "content": "▼ QWQ的定义和背景"}]}, {"type": "text", "index": 12, "bbox": [0.182, 0.418, 0.43, 0.432], "content": [{"type": "text", "content": "QWQ的定义和背景可以从多个角度进行解释:"}]}, {"type": "text", "index": 13, "bbox": [0.162, 0.44, 0.341, 0.455], "content": [{"type": "text", "content": "▼ DeepSeek-r1的定义和背景"}]}, {"type": "text", "index": 14, "bbox": [0.162, 0.469, 0.337, 0.484], "content": [{"type": "text", "content": "▼①中的主要功能和技术特点"}]}, {"type": "text", "index": 15, "bbox": [0.162, 0.499, 0.337, 0.513], "content": [{"type": "text", "content": "▼②中的主要功能和技术特点"}]}, {"type": "text", "index": 16, "bbox": [0.162, 0.528, 0.336, 0.543], "content": [{"type": "text", "content": "▼①中的应用场景和市场定位"}]}, {"type": "text", "index": 17, "bbox": [0.162, 0.557, 0.337, 0.572], "content": [{"type": "text", "content": "▼②中的应用场景和市场定位"}]}, {"type": "text", "index": 18, "bbox": [0.161, 0.586, 0.338, 0.602], "content": [{"type": "text", "content": "▼ ①中与②中的性能指标对比"}]}, {"type": "text", "index": 19, "bbox": [0.162, 0.616, 0.349, 0.631], "content": [{"type": "text", "content": "▼ 用户对①中和②中的评价反馈"}]}, {"type": "text", "index": 20, "bbox": [0.534, 0.632, 0.554, 0.646], "content": [{"type": "text", "content": "O"}]}, {"type": "paragraph_title", "index": 21, "bbox": [0.122, 0.691, 0.682, 0.708], "content": [{"type": "text", "content": "3、工具使用（Tool Use）:调用外部工具（如API、数据库）扩展能力边界。"}], "level": 2}, {"type": "text", "index": 22, "bbox": [0.435, 0.721, 0.607, 0.737], "content": [{"type": "text", "content": "大模型(比如:DeepSeek)"}]}, {"type": "image", "index": 23, "bbox": [0.13, 0.718, 0.875, 0.953], "content": [{"type": "image_body", "index": 23, "bbox": [0.13, 0.718, 0.875, 0.953], "content": ""}]}, {"type": "text", "index": 24, "bbox": [0.517, 0.775, 0.587, 0.792], "content": [{"type": "text", "content": "调用工具"}]}]}, {"page_idx": 21, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.123, 0.062, 0.279, 0.079], "content": [{"type": "text", "content": "4、记忆（Memory）"}], "level": 2}, {"type": "text", "index": 1, "bbox": [0.145, 0.09, 0.86, 0.124], "content": [{"type": "text", "content": "智能体像人类一样，能留存学到的知识以及交互习惯等，这样的机制能让智能体在处理重复工作时调用以前的经验，从而避免用户进行大量重复交互。"}]}, {"type": "text", "index": 2, "bbox": [0.14, 0.134, 0.873, 0.168], "content": [{"type": "text", "content": "短期记忆", "styles": ["bold"]}, {"type": "text", "content": ":存储单次对话周期的上下文信息，属于临时信息存储机制。受限于模型的上下文窗口长度。"}]}, {"type": "image", "index": 3, "bbox": [0.174, 0.179, 0.209, 0.203], "content": [{"type": "image_body", "index": 3, "bbox": [0.174, 0.179, 0.209, 0.203], "content": ""}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.218, 0.178, 0.264, 0.192], "content": [{"type": "text", "content": "康师傅"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.217, 0.213, 0.851, 0.244], "content": [{"type": "text", "content": "帮我随机生成40行左右的数据，包括品牌、大区、销售额。其中品牌有安踏、耐克、李宁、阿迪、匹克、鸿星尔克，大区为中国的身份，销售额范围10000-100000。每个品牌在多个省份销售。"}]}, {"type": "image", "index": 6, "bbox": [0.174, 0.284, 0.21, 0.31], "content": [{"type": "image_body", "index": 6, "bbox": [0.174, 0.284, 0.21, 0.31], "content": ""}]}, {"type": "paragraph_title", "index": 7, "bbox": [0.217, 0.285, 0.454, 0.299], "content": [{"type": "text", "content": "deepseek-ai/DeepSeek-V3 |硅基流动"}], "level": 2}, {"type": "text", "index": 8, "bbox": [0.217, 0.319, 0.673, 0.334], "content": [{"type": "text", "content": "以下是随机生成的40行数据示例，包括品牌、大区(中国省份)和销售额:"}]}, {"type": "table", "index": 9, "bbox": [0.22, 0.343, 0.871, 0.423], "content": [{"type": "table_body", "index": 9, "bbox": [0.22, 0.343, 0.871, 0.423], "content": "<table><tr><td>品牌</td><td>大区</td><td>销售额(元）</td></tr><tr><td>安踏</td><td>广东</td><td>85000</td></tr><tr><td>耐克</td><td>北京</td><td>92000</td></tr></table>"}]}, {"type": "image", "index": 10, "bbox": [0.173, 0.439, 0.209, 0.463], "content": [{"type": "image_body", "index": 10, "bbox": [0.173, 0.439, 0.209, 0.463], "content": ""}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.217, 0.438, 0.263, 0.451], "content": [{"type": "text", "content": "康师傅"}], "level": 2}, {"type": "text", "index": 12, "bbox": [0.218, 0.472, 0.561, 0.487], "content": [{"type": "text", "content": "上述数据没问题。但是需要按品牌分组，重新排列一下。"}]}, {"type": "image", "index": 13, "bbox": [0.172, 0.528, 0.209, 0.553], "content": [{"type": "image_body", "index": 13, "bbox": [0.172, 0.528, 0.209, 0.553], "content": ""}]}, {"type": "paragraph_title", "index": 14, "bbox": [0.216, 0.528, 0.453, 0.542], "content": [{"type": "text", "content": "deepseek-ai/DeepSeek-V3 |硅基流动"}], "level": 2}, {"type": "text", "index": 15, "bbox": [0.217, 0.562, 0.533, 0.577], "content": [{"type": "text", "content": "好的！以下是按照品牌分组重新排列后的数据示例:"}]}, {"type": "paragraph_title", "index": 16, "bbox": [0.217, 0.608, 0.339, 0.624], "content": [{"type": "text", "content": "按品牌分组数据"}], "level": 2}, {"type": "text", "index": 17, "bbox": [0.217, 0.638, 0.251, 0.652], "content": [{"type": "text", "content": "安踏"}]}, {"type": "table", "index": 18, "bbox": [0.22, 0.661, 0.872, 0.712], "content": [{"type": "table_body", "index": 18, "bbox": [0.22, 0.661, 0.872, 0.712], "content": "<table><tr><td>品牌</td><td>大区</td><td>销售额(元)</td></tr><tr><td>安踏</td><td>广东</td><td>85000</td></tr></table>"}]}, {"type": "text", "index": 19, "bbox": [0.185, 0.734, 0.455, 0.75], "content": [{"type": "text", "content": "ChatGPT:支持约8k token的上下文"}]}, {"type": "text", "index": 20, "bbox": [0.185, 0.758, 0.439, 0.774], "content": [{"type": "text", "content": "GPT4:支持约32k token的上下文"}]}, {"type": "text", "index": 21, "bbox": [0.183, 0.782, 0.849, 0.834], "content": [{"type": "text", "content": "最新的很多大模型:OpenAI GPT‐5.5 / GPT‐5.4 Pro支持100 万 Token（1M）、Anthropic Claude Opus 4.7支持200 万 Token、DeepSeek‐V4‐Pro支持100 万 Token、甚至有模型支持1000万 token的上下文 （相当于2000万字文本或20小时视频）"}]}, {"type": "text", "index": 22, "bbox": [0.14, 0.846, 0.759, 0.863], "content": [{"type": "text", "content": "长期记忆", "styles": ["bold"]}, {"type": "text", "content": ":可以 "}, {"type": "text", "content": "横跨多个会话或时间周期", "styles": ["underline"]}, {"type": "text", "content": " ，可存储并调用核心知识，非即时任务。"}]}, {"type": "text", "index": 23, "bbox": [0.177, 0.87, 0.54, 0.886], "content": [{"type": "text", "content": "比如，关于用户的偏"}, {"type": "text", "content": "好，过去执行过的指令等。", "styles": ["underline"]}]}, {"type": "text", "index": 24, "bbox": [0.177, 0.888, 0.876, 0.923], "content": [{"type": "text", "content": "长期记忆，可以通过 "}, {"type": "text", "content": "模型参数微调（固化知识） 知识图谱（结构化语义网络）", "styles": ["underline"]}, {"type": "text", "content": " 或 向量数据库（相似性检索） 方式实现。"}]}]}, {"page_idx": 22, "blocks": [{"type": "text", "index": 0, "bbox": [0.121, 0.035, 0.864, 0.071], "content": [{"type": "text", "content": "5、行动（Action）", "styles": ["bold"]}, {"type": "text", "content": ":实际执行决策的模块，涵盖软件接口操作（如自动订票）和物理交互（如机器人执行搬运）。比如:检索、推理、编程等。"}]}, {"type": "text", "index": 1, "bbox": [0.145, 0.08, 0.858, 0.115], "content": [{"type": "text", "content": "智能体会形成完整的计划流程。例如先读取以前工作的经验和记忆，之后规划子目标并使用相应工具去处理问题，最后输出给用户并完成反思。"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.122, 0.156, 0.456, 0.177], "content": [{"type": "text", "content": "5.3 大模型应用开发的4个场景"}], "level": 2}, {"type": "paragraph_title", "index": 3, "bbox": [0.122, 0.19, 0.307, 0.209], "content": [{"type": "text", "content": "场景1:纯 Prompt"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.14, 0.222, 0.406, 0.238], "content": [{"type": "text", "content": "Prompt是操作大模型的唯一接口"}]}, {"type": "text", "index": 5, "bbox": [0.14, 0.24, 0.587, 0.256], "content": [{"type": "text", "content": "当人看:你说一句，ta回一句，你再说一句，ta再回一句..."}]}, {"type": "image", "index": 6, "bbox": [0.232, 0.269, 0.768, 0.808], "content": [{"type": "image_body", "index": 6, "bbox": [0.232, 0.269, 0.768, 0.808], "content": ""}]}, {"type": "text", "index": 7, "bbox": [0.122, 0.826, 0.451, 0.845], "content": [{"type": "text", "content": "场景2:Agent + Function Calling", "styles": ["bold"]}]}, {"type": "text", "index": 8, "bbox": [0.14, 0.858, 0.331, 0.873], "content": [{"type": "text", "content": "Agent:AI 主动提要求"}]}, {"type": "text", "index": 9, "bbox": [0.139, 0.876, 0.622, 0.891], "content": [{"type": "text", "content": "Function Calling:需要对接外部系统时，AI 要求执行某个函数"}]}, {"type": "text", "index": 10, "bbox": [0.139, 0.893, 0.859, 0.927], "content": [{"type": "text", "content": "当人看:你问 ta「我明天去杭州出差，要带伞吗？」，ta 让你先看天气预报，你看了告诉ta，ta再告诉你要不要带伞"}]}]}, {"page_idx": 23, "blocks": [{"type": "image", "index": 0, "bbox": [0.127, 0.034, 0.874, 0.354], "content": [{"type": "image_body", "index": 0, "bbox": [0.127, 0.034, 0.874, 0.354], "content": ""}, {"type": "image_caption", "index": 1, "bbox": [0.122, 0.369, 0.603, 0.387], "content": [{"type": "text", "content": "场景3:RAG (Retrieval-Augmented Generation)"}]}]}, {"type": "text", "index": 2, "bbox": [0.123, 0.4, 0.359, 0.416], "content": [{"type": "text", "content": "RAG:需要补充领域知识时使用"}]}, {"type": "text", "index": 3, "bbox": [0.139, 0.427, 0.688, 0.442], "content": [{"type": "text", "content": "Embeddings:把文字转换为更易于相似度计算的编码。这种编码叫向量"}]}, {"type": "text", "index": 4, "bbox": [0.14, 0.445, 0.448, 0.46], "content": [{"type": "text", "content": "向量数据库:把向量存起来，方便查找"}]}, {"type": "text", "index": 5, "bbox": [0.14, 0.463, 0.496, 0.478], "content": [{"type": "text", "content": "向量搜索:根据输入向量，找到最相似的向量"}]}, {"type": "text", "index": 6, "bbox": [0.123, 0.49, 0.572, 0.506], "content": [{"type": "text", "content": "举例:考试答题时，到书上找相关内容，再结合题目组成答案"}]}, {"type": "image", "index": 7, "bbox": [0.129, 0.516, 0.875, 0.765], "content": [{"type": "image_body", "index": 7, "bbox": [0.129, 0.516, 0.875, 0.765], "content": ""}, {"type": "image_footnote", "index": 8, "bbox": [0.123, 0.779, 0.348, 0.795], "content": [{"type": "text", "content": "这个在智能客服上用的最广泛。"}]}]}, {"type": "text", "index": 9, "bbox": [0.122, 0.835, 0.423, 0.854], "content": [{"type": "text", "content": "场景4:Fine-tuning(精调/微调)", "styles": ["bold"]}]}, {"type": "text", "index": 10, "bbox": [0.122, 0.866, 0.479, 0.883], "content": [{"type": "text", "content": "举例:努力学习考试内容，长期记住，活学活用。"}]}]}, {"page_idx": 24, "blocks": [{"type": "image", "index": 0, "bbox": [0.132, 0.034, 0.875, 0.322], "content": [{"type": "image_body", "index": 0, "bbox": [0.132, 0.034, 0.875, 0.322], "content": ""}, {"type": "image_footnote", "index": 1, "bbox": [0.122, 0.333, 0.595, 0.35], "content": [{"type": "text", "content": "特点:成本最高；在前面的方式解决不了问题的情况下，再使用。"}]}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.123, 0.362, 0.294, 0.381], "content": [{"type": "text", "content": "如何选择相关技术"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.123, 0.393, 0.612, 0.41], "content": [{"type": "text", "content": "面对一个需求，如何开始，如何选择技术方案？下面是个常用思路:"}]}, {"type": "image", "index": 4, "bbox": [0.127, 0.423, 0.875, 0.717], "content": [{"type": "image_body", "index": 4, "bbox": [0.127, 0.423, 0.875, 0.717], "content": ""}]}]}], "is_full_document": true, "schema": "docvortex.middle", "schema_version": "2.0"}