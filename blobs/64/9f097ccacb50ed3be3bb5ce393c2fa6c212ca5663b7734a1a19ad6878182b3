, "height_pt": 841.9199829101562}, {"page_idx": 22, "width_pt": 594.9599609375, "height_pt": 841.9199829101562}, {"page_idx": 23, "width_pt": 594.9599609375, "height_pt": 841.9199829101562}, {"page_idx": 24, "width_pt": 594.9599609375, "height_pt": 841.9199829101562}]}}, "pages": [{"page_idx": 0, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.123, 0.075, 0.545, 0.101], "content": [{"type": "text", "content": "第01章:LangChain 1.2 概述"}], "level": 2}, {"type": "text", "index": 1, "bbox": [0.123, 0.113, 0.283, 0.13], "content": [{"type": "text", "content": "讲师:尚硅谷-宋红康"}]}, {"type": "text", "index": 2, "bbox": [0.123, 0.14, 0.229, 0.157], "content": [{"type": "text", "content": "官网:"}, {"type": "hyperlink", "url": "http://www.atguigu.com/", "content": [{"type": "text", "content": "尚硅谷"}]}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.124, 0.188, 0.483, 0.213], "content": [{"type": "text", "content": "1、为什么需要LangChain？"}], "level": 2}, {"type": "paragraph_title", "index": 4, "bbox": [0.124, 0.225, 0.443, 0.248], "content": [{"type": "text", "content": "1.1 从传统应用到智能体时代"}], "level": 2}, {"type": "image", "index": 5, "bbox": [0.222, 0.259, 0.834, 0.563], "content": [{"type": "image_body", "index": 5, "bbox": [0.222, 0.259, 0.834, 0.563], "content": ""}]}, {"type": "paragraph_title", "index": 6, "bbox": [0.125, 0.583, 0.466, 0.605], "content": [{"type": "text", "content": "1.2 单一的大语言模型的局限性"}], "level": 2}, {"type": "paragraph_title", "index": 7, "bbox": [0.309, 0.625, 0.692, 0.652], "content": [{"type": "text", "content": "单一的大语言模型的局限性"}], "level": 2}, {"type": "paragraph_title", "index": 8, "bbox": [0.165, 0.669, 0.351, 0.687], "content": [{"type": "text", "content": "1. 知识受限于训练数据"}], "level": 2}, {"type": "image", "index": 9, "bbox": [0.149, 0.693, 0.369, 0.845], "content": [{"type": "image_body", "index": 9, "bbox": [0.149, 0.693, 0.369, 0.845], "content": ""}]}, {"type": "text", "index": 10, "bbox": [0.152, 0.853, 0.364, 0.888], "content": [{"type": "text", "content": "1. 知识受限于训练数据无法获取训练时点之后的信息。"}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.39, 0.669, 0.61, 0.687], "content": [{"type": "text", "content": "2. 无法直接与外部系统交互"}], "level": 2}, {"type": "image", "index": 12, "bbox": [0.387, 0.667, 0.616, 0.845], "content": [{"type": "image_body", "index": 12, "bbox": [0.387, 0.667, 0.616, 0.845], "content": ""}]}, {"type": "text", "index": 13, "bbox": [0.392, 0.853, 0.612, 0.9], "content": [{"type": "text", "content": "2. 无法直接与外部系统交互无法查询实时数据、调用API或读取数据库。"}]}, {"type": "image", "index": 14, "bbox": [0.634, 0.667, 0.859, 0.84], "content": [{"type": "image_body", "index": 14, "bbox": [0.634, 0.667, 0.859, 0.84], "content": ""}]}, {"type": "text", "index": 15, "bbox": [0.641, 0.853, 0.851, 0.901], "content": [{"type": "text", "content": "3. 不具备状态保持能力难以进行连贯的多轮对话，遗忘之前的上下文。"}]}, {"type": "text", "index": 16, "bbox": [0.122, 0.916, 0.865, 0.951], "content": [{"type": "text", "content": "所以要构建真正实用的AI应用，必须将大语言模型与外部工具、数据源和记忆机制有机结合，从而催生了LangChain框架的设计理念。"}]}]}, {"page_idx": 1, "blocks": [{"type": "text", "index": 0, "bbox": [0.122, 0.036, 0.518, 0.052], "content": [{"type": "text", "content": "LangChain，是当前构建生产级 AI 智能体系统的"}, {"type": "text", "content": "首选", "styles": ["bold"]}, {"type": "text", "content": "。"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.123, 0.066, 0.425, 0.088], "content": [{"type": "text", "content": "1.3 LangChain框架的定位"}], "level": 2}, {"type": "image", "index": 2, "bbox": [0.125, 0.097, 0.874, 0.388], "content": [{"type": "image_body", "index": 2, "bbox": [0.125, 0.097, 0.874, 0.388], "content": ""}]}, {"type": "text", "index": 3, "bbox": [0.145, 0.398, 0.846, 0.434], "content": [{"type": "text", "content": "LangChain 作为大模型与应用间的中间层，可统一调用各类大模型、管理提示词与上下文，还能集成外部工具和数据源，快速搭建具备推理、行动能力的智能体。"}]}, {"type": "text", "index": 4, "bbox": [0.146, 0.442, 0.26, 0.459], "content": [{"type": "text", "content": "核心定位三点:"}]}, {"type": "text", "index": 5, "bbox": [0.166, 0.47, 0.748, 0.487], "content": [{"type": "text", "content": "1. "}, {"type": "text", "content": "打通大模型与外部资源", "styles": ["bold"]}, {"type": "text", "content": ":统一接口对接数据库、检索引擎、API、文件系统等；"}]}, {"type": "text", "index": 6, "bbox": [0.166, 0.489, 0.707, 0.504], "content": [{"type": "text", "content": "2. "}, {"type": "text", "content": "封装底层复杂逻辑", "styles": ["bold"]}, {"type": "text", "content": ":抽象工具调用、记忆等能力，降低智能体开发难度；"}]}, {"type": "text", "index": 7, "bbox": [0.166, 0.506, 0.859, 0.54], "content": [{"type": "text", "content": "3. "}, {"type": "text", "content": "支撑多智能体协作", "styles": ["bold"]}, {"type": "text", "content": ":依托 LangGraph 等生态，从单智能体拓展至多智能体协作，可构建工业级智能体。"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.124, 0.554, 0.424, 0.576], "content": [{"type": "text", "content": "1.4 LangChain的应用场景"}], "level": 2}, {"type": "image", "index": 9, "bbox": [0.125, 0.587, 0.874, 0.876], "content": [{"type": "image_body", "index": 9, "bbox": [0.125, 0.587, 0.874, 0.876], "content": ""}]}, {"type": "paragraph_title", "index": 10, "bbox": [0.123, 0.887, 0.296, 0.903], "content": [{"type": "text", "content": "1. 检索增强生成 (RAG)"}], "level": 2}, {"type": "text", "index": 11, "bbox": [0.139, 0.913, 0.573, 0.929], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 解决大模型知识滞后（无实时数据）和幻觉问题。"}]}, {"type": "text", "index": 12, "bbox": [0.139, 0.931, 0.807, 0.948], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 检索外部知识库（文档/数据库）并向量化，让模型基于最新、最相关的资料回答。"}]}]}, {"page_idx": 2, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.123, 0.036, 0.283, 0.052], "content": [{"type": "text", "content": "2. Agent 智能体构建"}], "level": 2}, {"type": "text", "index": 1, "bbox": [0.139, 0.063, 0.514, 0.078], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 解决 LLM 无法直接执行复杂任务的问题。"}]}, {"type": "text", "index": 2, "bbox": [0.139, 0.08, 0.863, 0.114], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 将模型作为“推理引擎”，自主规划路径并动态调用外部工具（如订票、查报告、写 SQL），实现复杂任务。"}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.123, 0.126, 0.312, 0.142], "content": [{"type": "text", "content": "3. 对话系统与聊天机器人"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.14, 0.153, 0.468, 0.168], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 解决多轮对话中的“记忆”流失问题。"}]}, {"type": "text", "index": 5, "bbox": [0.14, 0.17, 0.877, 0.204], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 集成记忆管理系统，记住用户偏好和历史交互，并结合私有数据（如教育教材、订单库）提供专业服务。"}]}, {"type": "paragraph_title", "index": 6, "bbox": [0.123, 0.216, 0.264, 0.231], "content": [{"type": "text", "content": "4. 多模态应用开发"}], "level": 2}, {"type": "text", "index": 7, "bbox": [0.14, 0.242, 0.408, 0.258], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 跨越单一文本交互的限制。"}]}, {"type": "text", "index": 8, "bbox": [0.139, 0.26, 0.817, 0.277], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 融合图像识别、语音转文字等技术，让模型具备处理音视频和图片的综合推理能力。"}]}, {"type": "paragraph_title", "index": 9, "bbox": [0.123, 0.287, 0.329, 0.303], "content": [{"type": "text", "content": "5. 自动化写作与格式化生成"}], "level": 2}, {"type": "text", "index": 10, "bbox": [0.139, 0.315, 0.555, 0.33], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 解决生成内容格式不标准、质量不稳定的问题。"}]}, {"type": "text", "index": 11, "bbox": [0.14, 0.333, 0.866, 0.366], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 配合提示词模板（Templates）与输出解析器（Parsers），自动产出规范的报告、合同或邮件。"}]}, {"type": "paragraph_title", "index": 12, "bbox": [0.123, 0.377, 0.312, 0.392], "content": [{"type": "text", "content": "6. 数据连接与结构化处理"}], "level": 2}, {"type": "text", "index": 13, "bbox": [0.139, 0.405, 0.554, 0.42], "content": [{"type": "text", "content": "痛点:", "styles": ["bold"]}, {"type": "text", "content": " 解决非结构化数据难以被模型直接利用的问题。"}]}, {"type": "text", "index": 14, "bbox": [0.139, 0.422, 0.868, 0.457], "content": [{"type": "text", "content": "功能:", "styles": ["bold"]}, {"type": "text", "content": " 强大的数据连接能力使大模型能够与各种数据源和结构化数据交互。比如，从 PDF、Excel中提取关键信息，或实现自然语言与 SQL 的自动转换。"}]}, {"type": "paragraph_title", "index": 15, "bbox": [0.124, 0.47, 0.392, 0.492], "content": [{"type": "text", "content": "1.5 大模型相关岗位介绍"}], "level": 2}, {"type": "image", "index": 16, "bbox": [0.125, 0.502, 0.875, 0.76], "content": [{"type": "image_body", "index": 16, "bbox": [0.125, 0.502, 0.875, 0.76], "content": ""}]}, {"type": "text", "index": 17, "bbox": [0.123, 0.771, 0.481, 0.788], "content": [{"type": "text", "content": "应用开发是大模型最值得关注的方向:"}, {"type": "text", "content": "应用为王！", "styles": ["bold"]}]}, {"type": "paragraph_title", "index": 18, "bbox": [0.31, 0.833, 0.676, 0.891], "content": [{"type": "text", "content": "8langchain"}], "level": 2}, {"type": "text", "index": 19, "bbox": [0.364, 0.909, 0.624, 0.926], "content": [{"type": "text", "content": "The agent engineering platform."}]}, {"type": "text", "index": 20, "bbox": [0.33, 0.932, 0.658, 0.946], "content": [{"type": "text", "content": "license downloads 1.8G v1.2.15 Follow @LangChain"}]}]}, {"page_idx": 3, "blocks": [{"type": "text", "index": 0, "bbox": [0.122, 0.035, 0.445, 0.052], "content": [{"type": "text", "content": "学习LangChain框架，高效开发大模型应用。"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.122, 0.065, 0.427, 0.089], "content": [{"type": "text", "content": "2、LangChain是什么？"}], "level": 2}, {"type": "paragraph_title", "index": 2, "bbox": [0.122, 0.102, 0.449, 0.125], "content": [{"type": "text", "content": "2.1 LangChain的发展时间线"}], "level": 2}, {"type": "chart", "index": 3, "bbox": [0.143, 0.149, 0.843, 0.482], "content": [{"type": "chart_body", "index": 3, "bbox": [0.143, 0.149, 0.843, 0.482], "content": ""}]}, {"type": "paragraph_title", "index": 4, "bbox": [0.122, 0.499, 0.35, 0.516], "content": [{"type": "text", "content": "第1阶段:诞生（2022年10月）"}], "level": 2}, {"type": "text", "index": 5, "bbox": [0.121, 0.526, 0.871, 0.597], "content": [{"type": "text", "content": "2022年10月，哈佛大学的机器学习项目工程师 "}, {"type": "text", "content": "Harrison Chase（哈里森·蔡斯）", "styles": ["underline"]}, {"type": "text", "content": " 创建了"}, {"type": "text", "content": "由大语", "styles": ["underline"]}, {"type": "text", "content": "言模型驱动的应用程序的开源框架:LangChain。其名称来源于\" "}, {"type": "text", "content": "Language", "styles": ["underline"]}, {"type": "text", "content": " \"（语言模型）和\" "}, {"type": "text", "content": "Chain", "styles": ["underline"]}, {"type": "text", "content": " \"（链式连接）的组合。体现了其核心设计理念——"}, {"type": "text", "content": "链接大语言模型与其他各种计算资源和数据，构建强大的AI应用。", "styles": ["bold"]}]}, {"type": "paragraph_title", "index": 6, "bbox": [0.122, 0.607, 0.446, 0.624], "content": [{"type": "text", "content": "第2阶段:探索期（2022年Q4—2023年Q1）"}], "level": 2}, {"type": "text", "index": 7, "bbox": [0.122, 0.634, 0.867, 0.67], "content": [{"type": "text", "content": "LangChain 初版发布，主要聚焦于PromptTemplate、LLMChain 等基础模块。其凭借前瞻性设计，在开源社区迅速走红，Gitlub Star 数快速破万，成为早期最受关注的大模型应用框架。"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.122, 0.679, 0.479, 0.696], "content": [{"type": "text", "content": "第3阶段:体系化阶段（2023年Q2—2023年Q4）"}], "level": 2}, {"type": "text", "index": 9, "bbox": [0.122, 0.705, 0.866, 0.739], "content": [{"type": "text", "content": "引入 Tool、Agent、Retrieval 等概念，形成大模型+工具调用+记忆的核心架构，支持构建完成更复杂任务的自"}, {"type": "text", "content": "动化智能体。", "styles": ["underline"]}]}, {"type": "text", "index": 10, "bbox": [0.122, 0.741, 0.778, 0.758], "content": [{"type": "text", "content": "同期推出 "}, {"type": "text", "content": "LangChain Hub", "styles": ["underline"]}, {"type": "text", "content": " 与 "}, {"type": "text", "content": "LangSmith", "styles": ["underline"]}, {"type": "text", "content": " ，初步构建了从开发、调试到部署的生态闭环。"}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.122, 0.769, 0.484, 0.786], "content": [{"type": "text", "content": "第4阶段:平台化阶段（2024年一2025年上半年）"}], "level": 2}, {"type": "text", "index": 12, "bbox": [0.122, 0.796, 0.863, 0.849], "content": [{"type": "text", "content": "LangGraph", "styles": ["underline"]}, {"type": "text", "content": " 与 "}, {"type": "text", "content": "LangServe", "styles": ["underline"]}, {"type": "text", "content": " 的发布是这一阶段的标志。LangGraph 为工作流管理提供了有向图基础，而LangServe则解决了服务化部署的难题。至此，LangChain生态完成了从开发框架到智能体平台的跃升。"}]}, {"type": "paragraph_title", "index": 13, "bbox": [0.122, 0.859, 0.479, 0.876], "content": [{"type": "text", "content": "第5阶段:深层智能体阶段（2025年下半年至今）"}], "level": 2}, {"type": "text", "index": 14, "bbox": [0.121, 0.886, 0.874, 0.938], "content": [{"type": "text", "content": "正式推出 "}, {"type": "text", "content": "Deep Agent", "styles": ["underline"]}, {"type": "text", "content": " ，官方定位为 "}, {"type": "text", "content": "Agent Harness（智能体执行框架）", "styles": ["underline"]}, {"type": "text", "content": " ，在LangGraph 和LangChain 之上运行，标志着LangChain 生态进入新阶段，让开发者可构建基于多智能体的复杂化智能体系统。"}]}]}, {"page_idx": 4, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.123, 0.036, 0.472, 0.058], "content": [{"type": "text", "content": "2.2 LangChain的两个重要版本"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.123, 0.071, 0.395, 0.088], "content": [{"type": "text", "content": "1、LangChain v0.3版本:既爱又恨"}], "level": 2}, {"type": "text", "index": 2, "bbox": [0.128, 0.098, 0.682, 0.115], "content": [{"type": "text", "content": "长期以来，LangChain 因为 API 变动频繁而被开发者戏称为“版本碎钞机”。"}]}, {"type": "text", "index": 3, "bbox": [0.122, 0.125, 0.872, 0.161], "content": [{"type": "text", "content": "一方面，2024"}, {"type": "text", "content": "年是LangChain架构重大变革的", "styles": ["underline"]}, {"type": "text", "content": "一年，LangChain团队推出了LangGraph作为底层智能体编排框架，并 "}, {"type": "text", "content": "将原有的链和智能体标记为弃用", "styles": ["underline"]}, {"type": "text", "content": " ，转而采用基于LangGraph构建的统一智能体抽象。"}]}, {"type": "text", "index": 4, "bbox": [0.122, 0.17, 0.874, 0.223], "content": [{"type": "text", "content": "另一方面，GPT-4逐渐普及，包括调用外部工具（Function calling）、结构化输出、系统提示词等功能，都成了模型的基础功能。而对于开发者而言，此时再 使用LangChain再对这些功能进行封装就显得多此一举 。"}]}, {"type": "text", "index": 5, "bbox": [0.123, 0.233, 0.382, 0.25], "content": [{"type": "text", "content": "此时，很多开发者的整体使用感受:"}]}, {"type": "image", "index": 6, "bbox": [0.126, 0.258, 0.872, 0.545], "content": [{"type": "image_body", "index": 6, "bbox": [0.126, 0.258, 0.872, 0.545], "content": ""}, {"type": "image_footnote", "index": 7, "bbox": [0.123, 0.558, 0.445, 0.574], "content": [{"type": "text", "content": "这个阶段，LangChain的开发者大规模流失。"}]}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.122, 0.613, 0.428, 0.629], "content": [{"type": "text", "content": "2、LangChain v1.x版本:AI开发新范式"}], "level": 2}, {"type": "text", "index": 9, "bbox": [0.143, 0.639, 0.665, 0.655], "content": [{"type": "text", "content": "在经历了短暂的阵痛后，LangChain进行了一次彻底的架构重构与瘦身。"}]}, {"type": "text", "index": 10, "bbox": [0.122, 0.667, 0.877, 0.719], "content": [{"type": "text", "content": "2025年10月20日", "styles": ["underline"]}, {"type": "text", "content": " ，LangChain团队正式发布"}, {"type": "text", "content": "了第一个正", "styles": ["underline"]}, {"type": "text", "content": "式大版本:LangChain v1.0.0与LangGraph v1.0.0，这是 AI 智能体（Agent）开发领域的 "}, {"type": "text", "content": "里程碑事件", "styles": ["underline"]}, {"type": "text", "content": " ，标志着框架的成熟和标准化，为企业级AI应用提供了稳定基础。"}]}, {"type": "text", "index": 11, "bbox": [0.122, 0.729, 0.864, 0.763], "content": [{"type": "text", "content": "官方首次明确 API 稳定保证: "}, {"type": "text", "content": "承诺在 2.0 版本前无破坏性变更", "styles": ["underline"]}, {"type": "text", "content": " 。这种稳定性对于企业级应用，是至关重要的。"}]}, {"type": "text", "index": 12, "bbox": [0.122, 0.773, 0.767, 0.791], "content": [{"type": "text", "content": "发布同期完成 "}, {"type": "text", "content": "1.2亿美元融资", "styles": ["underline"]}, {"type": "text", "content": " ，估值超 12 亿美元，印证其作为 AI 基础设施的战略价值。"}]}, {"type": "text", "index": 13, "bbox": [0.122, 0.828, 0.547, 0.845], "content": [{"type": "text", "content": "小结:对比 LangChain v0.3 与 LangChain v1.2（了解）", "styles": ["bold"]}]}]}, {"page_idx": 5, "blocks": [{"type": "table", "index": 0, "bbox": [0.125, 0.033, 0.875, 0.779], "content": [{"type": "table_body", "index": 0, "bbox": [0.125, 0.033, 0.875, 0.779], "content": "<table><tbody><tr><td>维度</td><td>LangChain v0.3</td><td>LangChain v1.2</td></tr><tr><td>核心</td><td></td><td></td></tr><tr><td>架构与</td><td>过渡性版本，设计上以链（Chain）</td><td>生产级稳定版本，标志着从\"链式调用\"到\"智能</td></tr><tr><td>设计理</td><td>为核心。</td><td>体框架\"的范式转变。</td></tr><tr><td>念</td><td></td><td></td></tr><tr><td>Agent</td><td>依赖initialize_agent等旧版</td><td>官方推荐使用create_agent作为 Agent 的</td></tr><tr><td>构建方</td><td>API，基于AgentExecutor硬编</td><td>标准构建入口，底层基于 LangGraph。</td></tr><tr><td>式</td><td>码。</td><td></td></tr><tr><td>工具定</td><td>通过@tool装饰器和Tool类定义，类型安全性和参数验证能力较</td><td>支持通过 Pydantic Schema 定义工具，类型</td></tr><tr><td>义</td><td>弱。</td><td>安全，参数定义更清晰。</td></tr><tr><td>结构化</td><td>主要依赖 JSON Parser 和正则表达</td><td>Structured Output成为一等公民，直接绑定 Pydantic 类，由模型底层保证输出格式稳</td></tr><tr><td>输出</td><td>式，稳定性较差。</td><td>定性。</td></tr><tr><td>输出解</td><td>输出为纯文本，需通过正则匹配等方式解析内容，较为繁琐且易出</td><td>引入标准化的content_blocks ，将模型输出（推理、文本、工具调用）统一为标准对象，</td></tr><tr><td>析</td><td>错。</td><td>无需再手动解析。</td></tr><tr><td>扩展机</td><td>缺乏系统性的扩展方式，修改逻辑</td><td>引入功能强大的Middleware（中间件）系统，允许在模型调用、工具执行等各生命周期</td></tr><tr><td>制</td><td>通常需要修改源码或提示词。</td><td>进行拦截和逻辑扩展。</td></tr><tr><td>多模态</td><td>支持不完善，无法无缝集成图像、</td><td>完善了多模态适配，可轻松实现多模态对话、</td></tr><tr><td>支持</td><td>音频等多模态数据。</td><td>多模态 RAG 等功能。</td></tr><tr><td>异步执</td><td>异步执行性能一般。</td><td>异步执行性能得到优化，据称响应速度提升</td></tr><tr><td>行性能</td><td></td><td>30% 以上。</td></tr><tr><td>包结构</td><td>包结构相对混乱，各模块耦合度较高。 langchain包为直接依赖。内</td><td>包结构清晰，主langchain包保持轻量，旧功能（如Chains ）被迁移至langchain-</td></tr><tr><td>与依赖</td><td>部从 Pydantic v1 升级到 v2，对依赖版本要求更严格。</td><td>classic包。 @langchain/core作为对等依赖，版本管理更灵活。</td></tr><tr><td>Python</td><td>要求 Python &gt;= 3.9（停止支持</td><td></td></tr><tr><td>版本要</td><td>Python 3.8）。</td><td>要求Python &gt;= 3.10。</td></tr><tr><td>求</td><td></td><td></td></tr><tr><td>推荐用</td><td>适用于维护依赖 v0.3 的老旧项目，</td><td>是所有新项目和学习 LangChain 的首选版本。官方承诺 1.x 版本系列不会引入破坏性</td></tr><tr><td>途</td><td>不推荐用于新项目开发。</td><td>变更，保证了长期稳定性。</td></tr></tbody></table>"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.122, 0.826, 0.479, 0.848], "content": [{"type": "text", "content": "2.3 LangChain v1.2的主要模块"}], "level": 2}]}, {"page_idx": 6, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.227, 0.043, 0.759, 0.069], "content": [{"type": "text", "content": "核心包最小化，每个模型供应商都有独立包。"}], "level": 2}, {"type": "image", "index": 1, "bbox": [0.125, 0.069, 0.874, 0.314], "content": [{"type": "image_body", "index": 1, "bbox": [0.125, 0.069, 0.874, 0.314], "content": ""}]}, {"type": "text", "index": 2, "bbox": [0.14, 0.324, 0.705, 0.341], "content": [{"type": "text", "content": "langchain-core :", "styles": ["underline"]}, {"type": "text", "content": "官方推荐的核心API。比如 Runnable, BaseMessage等"}]}, {"type": "text", "index": 3, "bbox": [0.14, 0.342, 0.877, 0.376], "content": [{"type": "text", "content": "langchain-classic :冗余代码移或不推荐使用的经典API移到此。比如0.x中常用而1.x移除的API都在这里。"}]}, {"type": "text", "index": 4, "bbox": [0.14, 0.378, 0.823, 0.412], "content": [{"type": "text", "content": "langchain-community", "styles": ["underline"]}, {"type": "text", "content": " :第三方集成，比如:合作伙伴包 langchain-openai，langchain"}, {"type": "text", "content": "anthropic等", "styles": ["underline"]}, {"type": "text", "content": "，按需安装、避免臃肿。"}]}, {"type": "text", "index": 5, "bbox": [0.14, 0.413, 0.864, 0.448], "content": [{"type": "text", "content": "langgraph", "styles": ["underline"]}, {"type": "text", "content": " :深度整合 LangGraph 1.0，协调多个Chain，Agent，Tools完成更复杂的任务，并且还支持循环调用，是langchain图形化的增强版"}]}]}, {"page_idx": 7, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.141, 0.038, 0.268, 0.05], "content": [{"type": "text", "content": "LangChain Reference"}], "level"